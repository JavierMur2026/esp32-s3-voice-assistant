# Copy this file to secrets.yaml in the SAME folder as the YAML (ESPHome
# config dir) and fill in your own values. Never commit secrets.yaml.

wifi_ssid: "YourNetworkSSID"
wifi_password: "YourWiFiPassword"

# 32 random bytes, base64-encoded. Generate with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# (the ESPHome dashboard also generates it automatically when you enable API
# encryption for the node)
api_encryption_key: "PASTE_GENERATED_KEY_HERE"

# Password used by `esphome upload` / OTA updates. Pick your own.
ota_password: "PickAnOTAPassword"

# Password of the fallback access point (only active if WiFi fails).
ap_password: "voice-assistant-setup"
